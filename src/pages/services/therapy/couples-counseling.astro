---
import Layout from "../../../layouts/Layout.astro";
import Schema from "../../../components/Schema.astro";
import { WIDGET_LINK } from "../../../data/resource";
import PageHeroWrapper from "../../../components/PageHeroWrapper.astro";
import AnimatedSection from "../../../components/react/primitives/AnimatedSection";
import SidebarCta from "../../../components/react/composites/SidebarCta";

const couplesTopics = [
  {
    title: "Communication and recurring conflict",
    detail:
      "Support for couples who get stuck in repeated arguments, withdrawal cycles, defensiveness, resentment, or difficulty staying connected under stress.",
  },
  {
    title: "Intimacy and connection",
    detail:
      "A space to understand intimacy needs, strengthen emotional connection, and discuss difficult topics without shame or judgment.",
  },
  {
    title: "LGBTQIA+ and non-traditional relationships",
    detail:
      "Affirming care for LGBTQIA+ couples and partners navigating kink, non-traditional relationship structures, identity, or changing expectations.",
  },
  {
    title: "Neurodivergent relationship dynamics",
    detail:
      "Affirming therapy for couples where one or both partners are neurodivergent, including support for ADHD-related patterns, sensory or emotional regulation differences, communication style mismatches, and demand-avoidance dynamics that can strain connection.",
  },
];

const siteUrl = Astro.site || new URL("https://www.twilightpsychology.com");
const couplesUrl = new URL(Astro.url.pathname, siteUrl).href;

const couplesSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Couples Counseling at Twilight Psychology",
  url: couplesUrl,
  keywords: [
    "couples counseling Kentucky",
    "LGBTQIA+ couples counseling Kentucky",
    "relationship therapy Kentucky",
    "self-pay couples counseling",
    "kink-informed couples therapy Kentucky",
  ],
  description:
    "Self-pay couples counseling in Lexington, KY with Danielle Morgan, LCSW, including affirming support for communication, intimacy, and conflict resolution.",
  provider: {
    "@type": "MedicalOrganization",
    name: "Twilight Psychology",
    url: "https://www.twilightpsychology.com",
  },
};
---

<Layout
  title="Couples Therapy in Lexington, KY"
  description="Self-pay couples counseling in Lexington, KY with Danielle Morgan, LCSW, including affirming support for communication, intimacy, and conflict resolution."
>
  <Schema slot="page-schema" schema={couplesSchema} />
  <PageHeroWrapper
    title="Couples Counseling"
    accentWord="Couples"
    badge="Adult Relationship Therapy"
    subtitle="Self-pay couples counseling in Lexington with Danielle Morgan, LCSW, focused on communication, intimacy, and conflict resolution."
    size="lg"
  />

        <section
          class="max-w-7xl mx-auto px-4 mt-16 grid lg:grid-cols-3 gap-12"
          aria-labelledby="couples-overview-heading"
        >
          <div class="lg:col-span-2 space-y-10">
            <AnimatedSection client:visible animation="fadeInUp" delay={100}>
              <section class="bg-surface-soft border border-border p-8 md:p-10 rounded-[2.5rem]">
                <h2 class="font-serif text-3xl font-black text-site-text mb-5 tracking-tight">
                  <span id="couples-overview-heading">Couples counseling with Danielle Morgan, LCSW</span>
                </h2>
                <div class="space-y-5 text-site-text leading-relaxed text-lg">
                  <p>
                    Danielle Morgan, LCSW will offer self-pay couples counseling for adults in
                    Lexington beginning December 2027. Her work focuses on communication,
                    intimacy, conflict resolution, and relationships affected by stress or
                    neurodivergence.
                  </p>
                  <p>
                    Danielle provides LGBTQIA+ affirming and kink-informed care, including support
                    for couples in non-traditional relationship structures. Couples counseling is
                    self-pay; <a href="/about/clinicians/danielle-morgan" class="font-bold text-cta hover:underline">view Danielle's profile</a>
                    to learn about her approach, credentials, and individual therapy services.
                  </p>
                </div>
              </section>
            </AnimatedSection>
          </div>

          <aside class="space-y-8">
            <AnimatedSection client:visible animation="slideInRight" delay={150}>
              <div class="bg-surface-soft border border-border p-8 rounded-[2.5rem]">
                <h3 class="font-serif text-xl font-black text-site-text mb-6">Related therapy pages</h3>
                <nav class="space-y-4">
                  <a
                    href="/services/therapy"
                    class="flex items-center justify-between p-4 bg-surface-soft rounded-2xl hover:bg-surface-2/30 transition-all text-site-text text-sm font-bold group"
                  >
                    Therapy home
                    <span class="text-cta group-hover:translate-x-1 transition-transform">→</span>
                  </a>
                  <a
                    href="/services/therapy/group-therapy"
                    class="flex items-center justify-between p-4 bg-surface-soft rounded-2xl hover:bg-surface-2/30 transition-all text-site-text text-sm font-bold group"
                  >
                    Group therapy
                    <span class="text-cta group-hover:translate-x-1 transition-transform">→</span>
                  </a>
                  <a
                    href="/services/therapy/clinicians"
                    class="flex items-center justify-between p-4 bg-surface-soft rounded-2xl hover:bg-surface-2/30 transition-all text-site-text text-sm font-bold group"
                  >
                    Therapy clinicians
                    <span class="text-cta group-hover:translate-x-1 transition-transform">→</span>
                  </a>
                  <a
                    href="/resources/fees"
                    class="flex items-center justify-between p-4 bg-surface-soft rounded-2xl hover:bg-surface-2/30 transition-all text-site-text text-sm font-bold group"
                  >
                    Fees and insurance
                    <span class="text-cta group-hover:translate-x-1 transition-transform">→</span>
                  </a>
                </nav>
              </div>
            </AnimatedSection>

            <SidebarCta
              client:visible
              title="Ask about couples counseling"
              description="Ask our intake team about Danielle's December 2027 opening, self-pay couples counseling, and whether her approach fits your relationship goals."
              buttonLabel="Schedule Intake"
              buttonHref={WIDGET_LINK}
              target="_blank"
              rel="noopener noreferrer"
            />
          </aside>
        </section>

        <section
          class="max-w-7xl mx-auto px-4 mt-24"
          aria-labelledby="couples-topics-heading"
        >
          <AnimatedSection client:visible animation="fadeInUp" delay={200}>
            <header class="max-w-3xl mb-10">
              <h2 class="font-serif text-3xl font-black text-site-text tracking-tight mb-4">
                <span id="couples-topics-heading">What couples counseling can help address</span>
              </h2>
              <p class="text-site-sub leading-relaxed">
                Relationship therapy is most useful when the work needs more structure than a general support
                conversation can offer.
              </p>
            </header>

            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
              {
                couplesTopics.map((topic) => (
                  <article class="rounded-3xl border border-border bg-surface-soft p-6">
                    <h3 class="font-serif text-xl font-black text-site-text mb-3">{topic.title}</h3>
                    <p class="text-site-sub text-sm leading-relaxed">{topic.detail}</p>
                  </article>
                ))
              }
            </div>
          </AnimatedSection>
        </section>

        <section
          class="max-w-7xl mx-auto px-4 mt-24 mb-12"
          aria-labelledby="couples-start-heading"
        >
          <AnimatedSection client:visible animation="fadeInUp" delay={250}>
              <div class="rounded-[2.5rem] border border-border bg-surface-soft p-8 md:p-10">
                <h2 class="font-serif text-3xl font-black text-site-text mb-4 tracking-tight">
                  <span id="couples-start-heading">Starting couples counseling</span>
                </h2>
                <div class="space-y-5 text-site-sub leading-relaxed">
                  <p>
                    Couples counseling with Danielle Morgan will open in December 2027. Sessions
                    are self-pay, and the intake team can explain current scheduling, fee, and
                    documentation expectations before you request an appointment.
                  </p>
                  <p>
                    If you need relationship support before December 2027, contact our office to
                    discuss other clinician matches or appropriate community referral options.
                  </p>
                </div>
                <div class="flex flex-wrap gap-4 mt-8">
                  <a
                    href="/resources/new-client"
                    class="inline-flex items-center gap-2 rounded-full bg-cta px-5 py-2.5 text-sm font-black text-cta-fg hover:bg-cta/80 transition-all"
                  >
                    Contact Our Team
                  </a>
                  <a
                    href="/resources/fees"
                    class="inline-flex items-center gap-2 rounded-full border border-border-strong px-5 py-2.5 text-sm font-bold text-site-text hover:bg-surface transition-colors"
                  >
                    Fees and insurance
                  </a>
                </div>
              </div>
          </AnimatedSection>
        </section>
</Layout>
