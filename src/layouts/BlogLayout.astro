---
import { getImage } from "astro:assets";
import "../styles/global.css";
import BlogHeader from "../components/blog/BlogHeader.astro";
import BlogFooter from "../components/blog/BlogFooter.astro";
import Schema from "../components/Schema.astro";
import SearchModal from "../components/SearchModal.astro";
import logoImage from "../assets/images/logo.png";
import { siteConfig } from "../data/siteConfig";
import { getCanonicalUrl } from "../utils/canonical";
import { hasDistinctUpdatedDate } from "../utils/blogDates";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  pubDate?: Date;
  updatedDate?: Date;
  author?: string;
  category?: string;
  image?: string;
  imageAlt?: string;
  seoTitle?: string;
  robots?: string;
  authorUrl?: string;
}

const {
  title,
  description = "Insights, updates, and clinical resources from Twilight Psychology.",
  canonical,
  pubDate,
  updatedDate,
  author,
  category,
  image,
  imageAlt,
  seoTitle,
  robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
  authorUrl,
} = Astro.props;

const siteUrl = Astro.site || new URL(siteConfig.siteUrl);

const canonicalURL = canonical || getCanonicalUrl(Astro.url.pathname, siteUrl);
const isArticle = !!pubDate;
const showModifiedMeta = pubDate ? hasDistinctUpdatedDate(pubDate, updatedDate) : false;
const metaTitle = seoTitle || title;
const pageTitle = metaTitle.includes(siteConfig.siteName)
  ? metaTitle
  : `${metaTitle} | ${siteConfig.siteName}`;
const ogImage = image || new URL("/og-image.png", siteUrl).href;
const ogImageAlt = imageAlt || `${metaTitle} preview image`;
const { src: faviconHref } = await getImage({
  src: logoImage,
  width: 64,
  height: 64,
  format: "png",
});
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteConfig.siteName,
  url: siteConfig.siteUrl,
  inLanguage: "en-US",
};
const webpageSchema = {
  "@context": "https://schema.org",
  "@type": isArticle ? "WebPage" : "CollectionPage",
  name: pageTitle,
  description,
  url: canonicalURL,
  inLanguage: "en-US",
  isPartOf: {
    "@type": "WebSite",
    name: siteConfig.siteName,
    url: siteConfig.siteUrl,
  },
  primaryImageOfPage: {
    "@type": "ImageObject",
    url: ogImage,
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/png" sizes="64x64" href={faviconHref} />
    <link rel="apple-touch-icon" href={faviconHref} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet" /></noscript>
    <title>{pageTitle}</title>
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {author && <meta name="author" content={author} />}
    <meta name="geo.region" content="US-KY" />
    <meta name="geo.placename" content="Lexington, Kentucky" />
    <meta name="geo.position" content="38.0406;-84.5037" />
    <meta name="ICBM" content="38.0406, -84.5037" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0a0c" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fcfcf9" />

    <!-- Theme initializer: prevents flash on load -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const theme = stored === "light" || stored === "dark" ? stored : "dark";
        document.documentElement.classList.remove("light", "dark");
        document.documentElement.classList.add(theme);
        document.documentElement.style.colorScheme = theme;
      })();
    </script>

    <!-- Open Graph -->
    <meta property="og:type" content={isArticle ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta property="og:locale" content="en_US" />
    {isArticle && pubDate && (
      <meta property="article:published_time" content={pubDate.toISOString()} />
    )}
    {isArticle && showModifiedMeta && updatedDate && (
      <meta property="article:modified_time" content={updatedDate.toISOString()} />
    )}
    {isArticle && author && (
      <meta property="article:author" content={authorUrl || `${siteConfig.siteUrl}/about/twilight-psychology`} />
    )}
    {isArticle && category && (
      <meta property="article:section" content={category} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Back-link to main site for SEO -->
    <link rel="home" href={siteConfig.siteUrl} />
    <Schema type="MentalHealthOrganization" name={siteConfig.siteName} />
    <Schema schemas={[websiteSchema, webpageSchema]} />
    <slot name="page-schema" />
  </head>

  <body class="flex min-h-screen flex-col bg-site-bg text-site-text antialiased">
    <!-- Skip link — WCAG 2.4.1 Bypass Blocks (Level A) -->
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <BlogHeader />

    <main id="main-content" class="grow" data-pagefind-body>
      <slot />
    </main>

    <BlogFooter />
    <SearchModal />
  </body>
</html>
