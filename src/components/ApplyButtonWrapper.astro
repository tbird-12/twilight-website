---
import ApplyButton from "../components/react/ApplyButton";

interface Props {
  position: string;
  ctaLabel: string;
  ctaVariant: "solid" | "outline";
  scriptURL?: string;
}

const { position, ctaLabel, ctaVariant, scriptURL } = Astro.props;
---

<ApplyButton
  client:visible
  position={position}
  ctaLabel={ctaLabel}
  ctaVariant={ctaVariant}
  scriptURL={scriptURL}
/>
