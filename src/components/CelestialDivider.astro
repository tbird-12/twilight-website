---
interface Props {
  type: "stars" | "ursa-minor" | "orbital" | "comet" | "crescent" | "compass";
}
const { type } = Astro.props;
---

<div class={`celestial-accent cel-${type}`} aria-hidden="true" role="presentation">

  {type === "stars" && (
    <svg viewBox="0 0 200 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="cel-svg">
      <circle class="cel-star" cx="22"  cy="42" r="1.5" style="animation-delay:0s"/>
      <circle class="cel-star cel-star--bright" cx="62" cy="18" r="2.2" style="animation-delay:.7s"/>
      <circle class="cel-star" cx="100" cy="55" r="1.3" style="animation-delay:1.4s"/>
      <circle class="cel-star cel-star--bright" cx="145" cy="22" r="2"   style="animation-delay:.3s"/>
      <circle class="cel-star" cx="178" cy="48" r="1.6" style="animation-delay:1.1s"/>
      <circle class="cel-star" cx="118" cy="38" r="1"   style="animation-delay:.5s"/>
    </svg>
  )}

  {type === "ursa-minor" && (
    <svg viewBox="0 0 240 200" fill="none" xmlns="http://www.w3.org/2000/svg" class="cel-svg cel-svg--ursa">
      <!-- Handle: Polaris → η → ζ → ε -->
      <line class="ursa-line ursa-line--1" x1="215" y1="165" x2="182" y2="143" pathLength="1"/>
      <line class="ursa-line ursa-line--2" x1="182" y1="143" x2="150" y2="118" pathLength="1"/>
      <line class="ursa-line ursa-line--3" x1="150" y1="118" x2="118" y2="102" pathLength="1"/>
      <!-- Bowl: ε → δ → γ → β → ε -->
      <line class="ursa-line ursa-line--4" x1="118" y1="102" x2="82"  y2="85"  pathLength="1"/>
      <line class="ursa-line ursa-line--5" x1="82"  y1="85"  x2="62"  y2="52"  pathLength="1"/>
      <line class="ursa-line ursa-line--6" x1="62"  y1="52"  x2="98"  y2="36"  pathLength="1"/>
      <line class="ursa-line ursa-line--7" x1="98"  y1="36"  x2="118" y2="102" pathLength="1"/>
      <!-- Polaris glow rings (behind the star) -->
      <circle class="ursa-glow ursa-glow--outer" cx="215" cy="165" r="18"/>
      <circle class="ursa-glow ursa-glow--inner" cx="215" cy="165" r="10"/>
      <!-- Stars (rendered on top of lines) -->
      <circle class="ursa-star" cx="182" cy="143" r="1.8" style="animation-delay:.4s"/>
      <circle class="ursa-star" cx="150" cy="118" r="1.8" style="animation-delay:1.1s"/>
      <circle class="ursa-star" cx="118" cy="102" r="2.1" style="animation-delay:.3s"/>
      <circle class="ursa-star" cx="82"  cy="85"  r="2.1" style="animation-delay:1.6s"/>
      <circle class="ursa-star" cx="62"  cy="52"  r="2.2" style="animation-delay:.8s"/>
      <circle class="ursa-star ursa-star--kochab"  cx="98"  cy="36"  r="2.8"/>
      <circle class="ursa-star ursa-star--polaris" cx="215" cy="165" r="3.5"/>
    </svg>
  )}

  {type === "orbital" && (
    <svg viewBox="0 0 240 120" fill="none" xmlns="http://www.w3.org/2000/svg" class="cel-svg">
      <defs>
        <clipPath id="cel-ring-front">
          <rect x="0" y="62" width="240" height="58"/>
        </clipPath>
      </defs>
      <!-- Back ring (behind planet) -->
      <ellipse class="orbit-ring"              cx="120" cy="62" rx="68" ry="18"/>
      <!-- Planet body -->
      <circle  class="orbit-planet"            cx="120" cy="62" r="26"/>
      <!-- Surface band -->
      <ellipse class="orbit-band"              cx="120" cy="58" rx="22" ry="7"/>
      <!-- Front ring (over planet, bottom half only) -->
      <ellipse class="orbit-ring orbit-ring--front" cx="120" cy="62" rx="68" ry="18" clip-path="url(#cel-ring-front)"/>
      <!-- Moons -->
      <circle class="cel-star" cx="34"  cy="26" r="2.5" style="animation-delay:0s"/>
      <circle class="cel-star" cx="198" cy="90" r="2"   style="animation-delay:1.2s"/>
      <circle class="cel-star" cx="210" cy="22" r="1.5" style="animation-delay:.6s"/>
    </svg>
  )}

  {type === "comet" && (
    <svg viewBox="0 0 240 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="cel-svg">
      <!-- Tail drawn with scroll animation -->
      <path class="comet-tail" d="M 210 50 Q 150 32 60 54 Q 25 62 8 68" pathLength="1"/>
      <!-- Head glow + head -->
      <circle class="comet-glow" cx="210" cy="50" r="12"/>
      <circle class="comet-head" cx="210" cy="50" r="4"/>
      <!-- Trail sparkles -->
      <circle class="cel-star" cx="155" cy="34" r="1.2" style="animation-delay:.3s"/>
      <circle class="cel-star" cx="98"  cy="52" r="1"   style="animation-delay:.9s"/>
      <circle class="cel-star" cx="52"  cy="60" r="1.3" style="animation-delay:1.5s"/>
    </svg>
  )}

  {type === "crescent" && (
    <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg" class="cel-svg cel-svg--square">
      <defs>
        <mask id="cel-crescent-mask">
          <circle cx="88" cy="100" r="52" fill="white"/>
          <circle cx="112" cy="88"  r="43" fill="black"/>
        </mask>
      </defs>
      <circle class="crescent-body" cx="88" cy="100" r="52" mask="url(#cel-crescent-mask)"/>
      <circle class="cel-star" cx="158" cy="40"  r="2.2" style="animation-delay:0s"/>
      <circle class="cel-star" cx="168" cy="88"  r="1.6" style="animation-delay:.8s"/>
      <circle class="cel-star" cx="152" cy="148" r="2"   style="animation-delay:1.4s"/>
      <circle class="cel-star" cx="30"  cy="58"  r="1.4" style="animation-delay:.4s"/>
      <circle class="cel-star" cx="22"  cy="142" r="1.8" style="animation-delay:1.1s"/>
    </svg>
  )}

  {type === "compass" && (
    <svg viewBox="0 0 220 120" fill="none" xmlns="http://www.w3.org/2000/svg" class="cel-svg cel-svg--compass">
      <circle class="compass-ring" cx="110" cy="60" r="34"/>
      <circle class="compass-ring compass-ring--inner" cx="110" cy="60" r="18"/>
      <path class="compass-needle compass-needle--north" d="M110 20 L118 60 L110 78 L102 60 Z"/>
      <path class="compass-needle compass-needle--south" d="M110 100 L118 60 L110 42 L102 60 Z"/>
      <circle class="compass-core" cx="110" cy="60" r="5"/>
      <path class="compass-axis" d="M110 10 V110 M10 60 H210"/>
      <circle class="cel-star" cx="58" cy="32" r="2" style="animation-delay:0s"/>
      <circle class="cel-star" cx="164" cy="28" r="1.8" style="animation-delay:.7s"/>
      <circle class="cel-star" cx="170" cy="90" r="1.6" style="animation-delay:1.3s"/>
      <circle class="cel-star" cx="48" cy="92" r="1.4" style="animation-delay:1.1s"/>
    </svg>
  )}

</div>

<style>
  /* ══════════════════════════════════════════════════════════════════
     LAYOUT STRATEGY
     Mobile  : position:relative (in-flow flex child of flex-column
               .hp-section).  align-self:center centers it horizontally
               without shrinking hp-section-inner.
     Desktop : position:absolute, bottom-right of the section —
               completely out of flow, decorative only.
  ══════════════════════════════════════════════════════════════════ */

  /* ── Mobile: in-flow, centered ─────────────────────────────────── */
  .celestial-accent {
    position: relative;
    align-self: center;
    padding: 2.25rem 2rem 1.25rem;
    pointer-events: none;
    user-select: none;
    color: rgba(var(--rgb-accent-alt), 0.9);
    z-index: 1;
  }

  /* Mobile SVG sizes — large enough to be clearly visible */
  .cel-svg            { width: 152px; height: 78px;  overflow: visible; }
  .cel-svg--ursa      { width: 152px; height: 127px; overflow: visible; }
  .cel-svg--square    { width: 96px; height: 96px;  overflow: visible; }
  .cel-svg--compass   { width: 160px; height: 94px; overflow: visible; }

  /* ── Desktop: absolute, bottom-right corner of the section ──────── */
  @media (min-width: 768px) {
    .celestial-accent {
      position: absolute;
      right: 2rem;
      bottom: 3rem;
      padding: 0;
      color: rgba(var(--rgb-accent-alt), 0.65);
      opacity: 0.48;       /* fallback for browsers without scroll-driven animations */
    }

    .cel-svg          { width: 165px; height: 107px; }
    .cel-svg--ursa    { width: 195px; height: 162px; }
    .cel-svg--square  { width: 125px; height: 125px; }
    .cel-svg--compass { width: 170px; height: 110px; }
  }

  @media (min-width: 1280px) {
    .celestial-accent { right: 3rem; }
    .cel-svg          { width: 195px; height: 125px; }
    .cel-svg--ursa    { width: 230px; height: 192px; }
    .cel-svg--square  { width: 148px; height: 148px; }
    .cel-svg--compass { width: 188px; height: 122px; }
  }

  /* ── Desktop scroll-driven opacity reveal ───────────────────────── */
  @supports (animation-timeline: view()) {
    @media (min-width: 768px) {
      @keyframes celestialFade {
        from { opacity: 0;    transform: translateY(10px); }
        to   { opacity: 0.48; transform: translateY(0);    }
      }
      .celestial-accent {
        opacity: 0;          /* override fallback for browsers WITH animation-timeline support */
        animation: celestialFade linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 55%;
      }
    }
  }

  /* ── Shared star twinkle (runs on both mobile + desktop) ────────── */
  @keyframes celTwinkle {
    0%, 100% { opacity: 0.5; }
    50%       { opacity: 1;  }
  }
  .cel-star {
    fill: rgba(var(--rgb-accent-alt), 0.85);
    animation: celTwinkle 2.8s ease-in-out infinite;
  }
  .cel-star--bright { fill: rgba(var(--rgb-accent-alt), 1); }

  /* ══ Ursa Minor constellation ════════════════════════════════════ */

  /* Lines: always fully visible on mobile.
     On desktop, hidden initially and revealed by scroll animation.  */
  .ursa-line {
    stroke: rgba(var(--rgb-accent-alt), 0.5);
    stroke-width: 0.9;
    stroke-linecap: round;
  }

  /* Desktop-only: scroll-driven line draw */
  @supports (animation-timeline: view()) {
    @media (min-width: 768px) {
      @keyframes celestialDraw {
        from { stroke-dashoffset: 1; opacity: 0.1; }
        to   { stroke-dashoffset: 0; opacity: 1;   }
      }
      .ursa-line {
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
        animation: celestialDraw linear both;
        animation-timeline: view();
      }
      .ursa-line--1 { animation-range: entry  5% cover 22%; }
      .ursa-line--2 { animation-range: entry  9% cover 26%; }
      .ursa-line--3 { animation-range: entry 13% cover 30%; }
      .ursa-line--4 { animation-range: entry 17% cover 34%; }
      .ursa-line--5 { animation-range: entry 21% cover 38%; }
      .ursa-line--6 { animation-range: entry 25% cover 42%; }
      .ursa-line--7 { animation-range: entry 29% cover 46%; }
    }
  }

  .ursa-star {
    fill: rgba(var(--rgb-accent-alt), 0.9);
    animation: celTwinkle 3.2s ease-in-out infinite;
  }

  /* Polaris — North Star: prominent pulse + glow rings */
  @keyframes polarisGlow {
    0%, 100% { r: 3.5; opacity: 0.9; }
    50%       { r: 5.8; opacity: 1;  }
  }
  .ursa-star--polaris {
    fill: rgba(var(--rgb-accent-alt), 1);
    animation: polarisGlow 2.6s ease-in-out infinite;
  }

  /* Kochab (β UMi) — brightest bowl star */
  @keyframes kochab {
    0%, 100% { r: 2.8; opacity: 0.75; }
    50%       { r: 3.8; opacity: 1;   }
  }
  .ursa-star--kochab {
    fill: rgba(var(--rgb-accent-alt), 0.95);
    animation: kochab 3.8s ease-in-out infinite;
  }

  .ursa-glow { fill: none; stroke-width: 0.75; }

  @keyframes glowInner {
    0%, 100% { r: 10; opacity: 0.5; }
    50%       { r: 14; opacity: 0.8; }
  }
  .ursa-glow--inner {
    stroke: rgba(var(--rgb-accent-alt), 0.4);
    animation: glowInner 2.6s ease-in-out infinite;
  }

  @keyframes glowOuter {
    0%, 100% { r: 18; opacity: 0.22; }
    50%       { r: 24; opacity: 0.42; }
  }
  .ursa-glow--outer {
    stroke: rgba(var(--rgb-accent-alt), 0.18);
    animation: glowOuter 2.6s ease-in-out infinite 0.4s;
  }

  /* ══ Orbital (Saturn-like) ═══════════════════════════════════════ */
  .orbit-ring { stroke: rgba(var(--rgb-accent-alt), 0.45); stroke-width: 1.5; fill: none; }
  .orbit-ring--front { stroke: rgba(var(--rgb-accent-alt), 0.65); stroke-width: 2; }
  .orbit-planet { fill: rgba(var(--rgb-accent-alt), 0.12); stroke: rgba(var(--rgb-accent-alt), 0.3); stroke-width: 1; }
  .orbit-band { fill: none; stroke: rgba(var(--rgb-accent-alt), 0.08); stroke-width: 7; }

  /* ══ Comet ════════════════════════════════════════════════════════ */
  /* Tail: always visible on mobile; draw animation desktop-only */
  .comet-tail {
    stroke: rgba(var(--rgb-accent-alt), 0.45);
    stroke-width: 1.5;
    stroke-linecap: round;
    fill: none;
  }

  @supports (animation-timeline: view()) {
    @media (min-width: 768px) {
      @keyframes cometDraw {
        from { stroke-dashoffset: 1; opacity: 0; }
        to   { stroke-dashoffset: 0; opacity: 1; }
      }
      .comet-tail {
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
        animation: cometDraw linear both;
        animation-timeline: view();
        animation-range: entry 8% cover 42%;
      }
    }
  }

  @keyframes cometGlowAnim {
    0%, 100% { r: 12; opacity: 0.45; }
    50%       { r: 16; opacity: 0.7;  }
  }
  .comet-glow { fill: rgba(var(--rgb-accent-alt), 0.1); animation: cometGlowAnim 2.2s ease-in-out infinite; }

  @keyframes cometHeadAnim {
    0%, 100% { r: 4;   opacity: 0.9; }
    50%       { r: 5.8; opacity: 1;  }
  }
  .comet-head { fill: rgba(var(--rgb-accent-alt), 0.95); animation: cometHeadAnim 2.2s ease-in-out infinite; }

  /* ══ Crescent Moon ════════════════════════════════════════════════ */
  @keyframes crescentGlowAnim {
    0%, 100% { fill: rgba(var(--rgb-accent-alt), 0.15); }
    50%       { fill: rgba(var(--rgb-accent-alt), 0.28); }
  }
  .crescent-body {
    fill: rgba(var(--rgb-accent-alt), 0.15);
    stroke: rgba(var(--rgb-accent-alt), 0.45);
    stroke-width: 0.8;
    animation: crescentGlowAnim 4.5s ease-in-out infinite;
  }

  /* ══ Compass ═══════════════════════════════════════════════════════ */
  .compass-ring {
    fill: none;
    stroke: rgba(var(--rgb-accent-alt), 0.45);
    stroke-width: 1.2;
  }

  .compass-ring--inner {
    stroke: rgba(var(--rgb-accent-alt), 0.28);
  }

  .compass-axis {
    stroke: rgba(var(--rgb-accent-alt), 0.25);
    stroke-width: 0.8;
    stroke-dasharray: 2 3;
  }

  .compass-needle {
    fill: rgba(var(--rgb-accent-alt), 0.18);
    stroke: rgba(var(--rgb-accent-alt), 0.55);
    stroke-width: 0.8;
  }

  .compass-needle--north {
    fill: rgba(var(--rgb-accent-alt), 0.22);
  }

  .compass-needle--south {
    fill: rgba(var(--rgb-accent-alt), 0.12);
  }

  .compass-core {
    fill: rgba(var(--rgb-accent-alt), 0.95);
    stroke: rgba(var(--rgb-accent-alt), 0.8);
    stroke-width: 0.5;
  }

  /* ══ Reduced motion ═══════════════════════════════════════════════ */
  @media (prefers-reduced-motion: reduce) {
    /* Stop all looping animations; keep art visible */
    .cel-star,
    .ursa-star,
    .ursa-star--polaris,
    .ursa-star--kochab,
    .ursa-glow--inner,
    .ursa-glow--outer,
    .comet-glow,
    .comet-head,
    .crescent-body,
    .compass-ring,
    .compass-ring--inner,
    .compass-axis,
    .compass-needle,
    .compass-core {
      animation: none !important;
      opacity: 0.75 !important;
    }

    /* Desktop: show art statically without scroll animation */
    @media (min-width: 768px) {
      .celestial-accent {
        animation: none !important;
        opacity: 0.45 !important;
        transform: none !important;
      }
      /* Lines: show fully visible */
      .ursa-line {
        animation: none !important;
        stroke-dashoffset: 0 !important;
        opacity: 0.6 !important;
      }
      .comet-tail {
        animation: none !important;
        stroke-dashoffset: 0 !important;
        opacity: 0.5 !important;
      }
    }
  }
</style>
